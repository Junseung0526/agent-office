#!/usr/bin/env bash
# ==============================================================================
# 🏢 에이전트 오피스 (Agent Office) - 더블클릭 실행 런처
# ==============================================================================

cd "$(dirname "$0")" || exit 1

./office.sh start --open

echo ""
echo "===================================================="
echo "  🏢 [에이전트 오피스] 브라우저 대시보드가 열렸습니다!"
echo "  👉 서버는 백그라운드에서 계속 실행됩니다."
echo "  💡 이 터미널 창은 닫으셔도 서버에 영향이 없습니다."
echo "===================================================="
echo ""

sleep 2
exit 0
