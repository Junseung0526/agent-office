#!/usr/bin/env bash
# ==============================================================================
# 에이전트 오피스 (Agent Office) - 더블클릭 실행 런처
# ==============================================================================

cd "$(dirname "$0")" || exit 1

./office.sh start --open

echo ""
echo "서버는 백그라운드에서 계속 실행됩니다. 이 창은 닫아도 됩니다."
echo "종료하려면: ./office.sh stop"

sleep 2
exit 0
